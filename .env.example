# Copy this file to .env and adjust if needed:
# cp .env.example .env

# Ollama Host URL (where Ollama service is running)
OLLAMA_HOST=http://localhost:11434

# Ollama Model Name
MODEL_NAME=qwen3.5:4b

# Backend FastAPI Port
PORT=8000

# Frontend Vite Dev Server Port
FRONTEND_PORT=5173

# Frontend API URL (optional override, leave empty to use relative proxy)
VITE_API_URL=http://localhost:8000
